{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Current Python File (Project Setup)",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal"
    }
  ]
}